<!-- Defence in depth: the app's own HTTPS client trusts only the shipped GSMA CI roots (TlsPolicy)
     and never uses the default trust. Should anything else open a connection, it gets no
     cleartext and trusts no CA at all, neither system nor user. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
</network-security-config>
