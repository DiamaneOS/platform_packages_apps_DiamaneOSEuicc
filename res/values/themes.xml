<resources>
    <!-- The Settings look (SettingsLib), as GrapheneOS's GmsCompat screens use it. -->
    <style name="Theme.DiamaneOSEuicc" parent="Theme.SubSettingsBase.Expressive">
        <!-- CollapsingToolbarBaseActivity sets its own toolbar as the action bar. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Ignore taps while another app's window covers this one. -->
        <item name="android:filterTouchesWhenObscured">true</item>
    </style>
</resources>
