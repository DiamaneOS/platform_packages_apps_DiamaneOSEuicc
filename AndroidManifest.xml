<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     DiamaneOS's eSIM manager (LPA): manages the profiles on the eUICC and downloads new ones.

     - Disabled until the user turns on Settings > Network & internet > eSIM support, which
       enables the package and restarts the phone (as GrapheneOS does for Google's LPA).
     - Two privileged permissions, allowlisted in privapp-permissions-de.diamaneos.euicc.xml:
       WRITE_EMBEDDED_SUBSCRIPTIONS (the framework binds only an LPA that holds it; the screens
       use it for refreshes and downloads) and READ_PRIVILEGED_PHONE_STATE (the slot list,
       which gives the eUICC's card ID; every card command needs it).
     - INTERNET only for SGP.22 downloads, checks, searches and notifications the user starts
       or that follow the user's own change, over HTTPS pinned to the GSMA CI roots
       (network_security_config.xml trusts nothing else). No camera permission: the camera
       app's QR scanner reads codes. No backup.
     - HIDE_OVERLAY_WINDOWS (normal): the Add eSIM windows hide other apps' overlays.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.diamaneos.euicc">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_EMBEDDED_SUBSCRIPTIONS" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- "Scan QR code" opens the OS's QR scanner (config_defaultQrCodeComponent), an activity
         of the camera app, by name: that needs the camera app to be visible. -->
    <queries>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DiamaneOSEuicc"
        android:enabled="false"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Only the phone process (BIND_EUICC_SERVICE, signature) can bind it. The framework
             requires the permission and a non-zero priority. Direct boot aware so the
             framework can read the profiles before the first unlock. -->
        <service
            android:name=".EuiccLpaService"
            android:permission="android.permission.BIND_EUICC_SERVICE"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.EuiccService" />
            </intent-filter>
        </service>

        <!-- No launcher icon, as on GrapheneOS: Settings opens the profile list (Network &
             internet > Manage eSIMs) through the alias below. -->
        <activity
            android:name=".ui.ProfilesActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="false" />

        <!-- EuiccManager.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS, forwarded by the phone process,
             which holds BIND_EUICC_SERVICE. -->
        <activity-alias
            android:name=".ui.ManageEmbeddedSubscriptions"
            android:targetActivity=".ui.ProfilesActivity"
            android:permission="android.permission.BIND_EUICC_SERVICE"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.action.MANAGE_EMBEDDED_SUBSCRIPTIONS" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.service.euicc.category.EUICC_UI" />
            </intent-filter>
        </activity-alias>

        <!-- Add eSIM, from the eSIM screen. -->
        <activity
            android:name=".ui.AddEsimActivity"
            android:label="@string/add_title"
            android:exported="false" />

        <!-- EuiccManager.ACTION_PROVISION_EMBEDDED_SUBSCRIPTION (Settings' "Add SIM"), forwarded
             by the phone process, which holds BIND_EUICC_SERVICE. -->
        <activity-alias
            android:name=".ui.ProvisionEmbeddedSubscription"
            android:targetActivity=".ui.AddEsimActivity"
            android:permission="android.permission.BIND_EUICC_SERVICE"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.action.PROVISION_EMBEDDED_SUBSCRIPTION" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.service.euicc.category.EUICC_UI" />
            </intent-filter>
        </activity-alias>

        <!-- "Open with" for a scanned "LPA:" code (the camera app's QR result): fills it in on
             Add eSIM, where the user still agrees before anything connects. Not browsable.
             Uppercase scheme too: QR codes carry "LPA:" and scheme matching is case-sensitive. -->
        <activity
            android:name=".ui.OpenCodeActivity"
            android:label="@string/add_title"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="LPA" />
                <data android:scheme="lpa" />
            </intent-filter>
        </activity>

        <!-- EuiccManager.downloadSubscription's result, through an explicit PendingIntent. -->
        <receiver
            android:name=".download.DownloadResultReceiver"
            android:exported="false" />
    </application>
</manifest>
