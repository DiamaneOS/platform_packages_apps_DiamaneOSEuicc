<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     DiamaneOS's eSIM manager (LPA): manages the profiles already on the eUICC.

     - Disabled until the user turns on Settings > Network & internet > eSIM support, which
       enables the package and restarts the phone (as GrapheneOS does for Google's LPA).
     - Two privileged permissions, allowlisted in privapp-permissions-de.diamaneos.euicc.xml:
       WRITE_EMBEDDED_SUBSCRIPTIONS (the framework binds only an LPA that holds it; the screen
       uses it to ask for a profile refresh) and READ_PRIVILEGED_PHONE_STATE (the slot list,
       which gives the eUICC's card ID; every card command needs it).
     - No INTERNET: no network access at all. No storage, no backup.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.diamaneos.euicc">

    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_EMBEDDED_SUBSCRIPTIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DiamaneOSEuicc"
        android:enabled="false"
        android:allowBackup="false">

        <!-- Only the phone process (BIND_EUICC_SERVICE, signature) can bind it. The framework
             requires the permission and a non-zero priority. Direct boot aware so the
             framework can read the profiles before the first unlock. -->
        <service
            android:name=".EuiccLpaService"
            android:permission="android.permission.BIND_EUICC_SERVICE"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.EuiccService" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.ProfilesActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- EuiccManager.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS, forwarded by the phone process,
             which holds BIND_EUICC_SERVICE. -->
        <activity-alias
            android:name=".ui.ManageEmbeddedSubscriptions"
            android:targetActivity=".ui.ProfilesActivity"
            android:permission="android.permission.BIND_EUICC_SERVICE"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.service.euicc.action.MANAGE_EMBEDDED_SUBSCRIPTIONS" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.service.euicc.category.EUICC_UI" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
